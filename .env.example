# ===========================================================================
# PhotoPi configuration. Copy to ".env" and edit before first launch:
#     cp .env.example .env
# ===========================================================================

# --- Host paths ------------------------------------------------------------
# Absolute path on the Raspberry Pi to your extracted Google Photos Takeout
# export (the folder that contains the "Takeout" / "Google Photos" tree).
# This is mounted read-only into the backend container.
PHOTOS_DIR=/mnt/google-photos

# Port the web UI is published on. Browse to http://<pi-ip>:<WEB_PORT>
WEB_PORT=8080

# --- Security (CHANGE THESE) ----------------------------------------------
# Long random string used to sign login tokens. Generate one with:
#     openssl rand -hex 32
JWT_SECRET=change-me-please-use-a-long-random-string

# Bootstrap admin account, created the first time the backend starts.
# Change ADMIN_PASSWORD here, or via the in-app password dialog afterwards.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Allow unauthenticated browsing of shared albums (true/false).
ALLOW_GUEST=false

# --- Indexing / Raspberry Pi performance tuning ---------------------------
# Files written to the database per transaction.
INDEX_BATCH_SIZE=50
# Directory entries read per filesystem scan chunk.
SCAN_CHUNK_SIZE=250
# Milliseconds to sleep between files. Raise (e.g. 20-50) if the Pi gets
# too hot or unresponsive during indexing; 0 = index as fast as possible.
INDEX_THROTTLE_MS=0
# Threads for image/video processing. Keep at 1 on a Pi 3B+.
THUMB_WORKERS=1

# --- Thumbnails ------------------------------------------------------------
THUMB_SIZE=320
PREVIEW_SIZE=1280
THUMB_QUALITY=75
ENABLE_VIDEO_THUMBS=true

# --- PostgreSQL (only used with docker-compose.postgres.yml) --------------
POSTGRES_USER=photopi
POSTGRES_PASSWORD=photopi
POSTGRES_DB=photopi
